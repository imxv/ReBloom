  "benchmarkSource": "import Foundation\nimport ImageIO\nimport CoreGraphics\n\nvar records: [[String: Any]] = []\nfor name in CommandLine.arguments.dropFirst() {\n  let url = URL(fileURLWithPath: name)\n  for dimension in [0, 512, 1024] {\n    autoreleasepool {\n      let start = Date.timeIntervalSinceReferenceDate\n      guard let source = CGImageSourceCreateWithURL(url as CFURL, [kCGImageSourceShouldCache: false] as CFDictionary) else { fatalError(\"Cannot open input\") }\n      let result: CGImage?\n      if dimension == 0 {\n        result = CGImageSourceCreateImageAtIndex(source, 0, [kCGImageSourceShouldCacheImmediately: true] as CFDictionary)\n      } else {\n        result = CGImageSourceCreateThumbnailAtIndex(source, 0, [\n          kCGImageSourceCreateThumbnailFromImageAlways: true,\n          kCGImageSourceCreateThumbnailWithTransform: true,\n          kCGImageSourceShouldCacheImmediately: true,\n          kCGImageSourceThumbnailMaxPixelSize: dimension\n        ] as CFDictionary)\n      }\n      guard let image = result else { fatalError(\"Cannot decode input\") }\n      records.append([\n        \"file\": name, \"maximumDimension\": dimension,\n        \"width\": image.width, \"height\": image.height,\n        \"bitmapBytes\": image.bytesPerRow * image.height,\n        \"milliseconds\": (Date.timeIntervalSinceReferenceDate - start) * 1000\n      ])\n    }\n  }\n}\nlet report: [String: Any] = [\"scope\": \"macOS ImageIO decode experiment, not iOS app RSS, frame rate, or device benchmark\", \"records\": records]\nlet data = try JSONSerialization.data(withJSONObject: report, options: [.prettyPrinted, .sortedKeys])\nprint(String(decoding: data, as: UTF8.self))\n",
  "benchmarkCommand": "xcrun swiftc -O .artifacts/thumbnail-audit/benchmark.swift -o .artifacts/thumbnail-audit/benchmark; run with the seven input paths listed in records",
  "limitations": [
    "bitmapBytes is bytesPerRow * height, not process RSS or allocation peak.",
    "macOS ImageIO measurements do not prove iOS UI latency, scrolling performance, or true-device behavior.",
    "Elapsed times are one pass on a busy developer machine and are not used as a performance comparison.",
    "No original, AI source, sticker, stored media, or regression baseline was changed."
  ]
